<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>
<VBox xmlns:fx="http://javafx.com/fxml/1" minHeight="512.0" minWidth="512.0" xmlns="http://javafx.com/javafx/17.0.2-ea">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <ToolBar nodeOrientation="LEFT_TO_RIGHT" prefHeight="40.0" prefWidth="200.0">
        <items>
            <TextField fx:id="degree" maxWidth="200" promptText="Degree">

            </TextField>
            <TextField maxWidth="200" promptText="x Times" text="1" fx:id="xTimes">

            </TextField>
            <Button fx:id="ledPower" mnemonicParsing="false" text="Mal de"/>
        </items>
    </ToolBar>

    <Label fx:id="welcomeText" text="How are doing..."/>
    <ToolBar prefHeight="40.0" prefWidth="200.0">
        <items>
            <TextField fx:id="urlInput" text="https://www.google.com"/>
            <Button fx:id="btn2" mnemonicParsing="false" text="B2"/>
            <Button fx:id="btn1" alignment="CENTER" text="B1">
                <effect>
                    <Blend/>
                </effect>
            </Button>
            <ProgressBar fx:id="progressBar"/>
        </items>
    </ToolBar>
    <VBox prefHeight="600.0" prefWidth="177.0">
        <children>
            <WebView fx:id="webView" fontSmoothingType="GRAY"/>
        </children>
    </VBox>
</VBox>
